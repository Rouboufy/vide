#!/bin/bash
# Script to open files in the active Neovim pane from Yazi
# Extract Neovim pane ID from YAZI_ID
NVIM_PANE_ID="${YAZI_ID#vide_yazi_}"

if [ -n "$NVIM_PANE_ID" ]; then
  PIPE_PATH="/tmp/vide_nvim_${NVIM_PANE_ID}.pipe"
  if [ -S "$PIPE_PATH" ]; then
    # Get absolute path of file
    FILE_PATH="$(realpath "$1")"
    # Send remote command to Neovim to edit the file
    nvim --server "$PIPE_PATH" --remote-send "<C-\><C-N>:edit ${FILE_PATH}<CR>"
    
    # Shift focus back to Neovim pane in WezTerm
    wezterm cli activate-pane --pane-id "$NVIM_PANE_ID"
    exit 0
  fi
fi

# Fallback: if not running under Vide's split, open normally
exec nvim "$@"
